	quest.32772B06D25FE5FF.quest_desc: ["At the end of your adventure on the Chroma Endless modpack you will be able to create various creative items !"]
	quest.32772B06D25FE5FF.title: "&dCreative&r"
	quest.33DFBD6ADA6339F1.quest_desc: [
		"FTB Chunks allows you to &cclaim chunks&r in order to &aprotect&r your blocks."
		""
		"This claims also protects your chunks from &cexplosions &rand from &dPVP&r."
		""
		"&7&oThis parameters can be modified in team parameters. You can find them in the top left corner of your inventory. My Team > Parameters > FTB Chunks Properties"
		""
		"FTB Chunks also has a &9minimap and large map&r ! You can find it in the top left corner of your inventory."
		""
		"&bRight-click&r anywhere on map to create a waypoint."
		""
		"&bRight-click&r on waypoints and death points to edit or delete them."
		""
		"Click on &9Claimed Chunks button&r, then &bleft-click&r on map to select chunks that you can to claim."
		""
		"&bRight-click&r on a claimed chunk to unclaim it."
		""
		"&bShift-left-click&r on claimed chunks to forceload it."
		""
		"&bShift-right-click&r on forceloaded chunks to unforceload it."
	]
