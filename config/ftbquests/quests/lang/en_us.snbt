	quest.3FCBA1147733405D.quest_desc: [
		""
		"&l&n&aTechnic Resources&r is a modpack based on Create and Mekanism, there is a lot of quest and custom items"
		"                "
		"This is an &lsemi-expert modpack&r, but even if you are a &lbeginner&r, you can play as the &lquests&r will help you a lot, and you can also join the &lDiscord server&r for &lsupport&r."
		""
		"The modpack is divided in &l2 phases&r : "
		""
		"- &lEscape &rfrom the bedrock box"
		""
		"- &lAutomations &rfor the end game"
		"               "
		"                                              &l&n&aHave fun!&r&r&r"
	]
